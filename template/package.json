{
  "name": "dafeiyu-film",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "大肥鱼影业 · 一支片子的完整工程（影片源码 + 编辑台 + 出片脚本）",
  "scripts": {
    "start": "node scripts/launch.cjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "studio": "remotion studio src/remotion/index.ts",
    "film": "remotion studio film/index.ts",
    "render": "node scripts/render-film.cjs",
    "render:check": "node scripts/render-film.cjs --check",
    "qa": "node scripts/qa.mjs",
    "derive": "node scripts/derive.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "@remotion/google-fonts": "4.0.484",
    "@remotion/motion-blur": "4.0.484",
    "@remotion/player": "4.0.484",
    "@remotion/three": "4.0.484",
    "@remotion/zod-types": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484",
    "three": "0.185.1",
    "zod": "4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.484",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0"
  }
}
